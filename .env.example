# ─── Core app ─────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Clerk ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=              # Clerk dashboard → Webhooks → Signing secret (for user.created provisioning)

# ─── Cloudinary ───────────────────────────────────────────────────────

NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Replicate (SDXL + Ideogram) ──────────────────────────────────────
export REPLICATE_API_TOKEN=your_token

# ─── Upstash Redis (credits gate + rate limit) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
